# Copy to .env.local and adjust.

# External backend (FastAPI) implementing POST {API_URL}/v1/chat. Leave unset to use the built-in pipeline.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Built-in pipeline (default): llama.cpp server started by `npm run llm`, RAG over ./corpus.
# LLM_URL=http://127.0.0.1:8080
# LLM_MODEL=sahayak
# LLM_HF_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M   # what `npm run llm` pulls and serves
# LLM_CTX=8192

# Canned answer stream instead of a model (UI development):
# NEXT_PUBLIC_CHAT_MODE=mock
