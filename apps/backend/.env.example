# Copy to .env and adjust. The backend is the API on http://127.0.0.1:4000 by default.

# Postgres connection string (required). Supabase: Project Settings > Database > Connection string (URI);
# use the Session pooler (port 5432) or Transaction pooler (6543) and replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DB_SSL=0                            # only for a local Postgres without TLS
# DB_POOL=5                           # connections per backend process

# PORT=4000
# HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:3000   # only needed when the browser talks to the backend directly (NEXT_PUBLIC_API_URL)
# COOKIE_SECURE=0                     # allow the session cookie over plain http in production (behind a TLS proxy leave unset)

# Chat model: llama.cpp server started by `npm run llm`.
# LLM_URL=http://127.0.0.1:8080
# LLM_MODEL=sahayak
# LLM_HF_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M   # what `npm run llm` pulls and serves
# LLM_CTX=16384
# LLM_API_KEY=change-me          # passed to llama-server as --api-key and sent as a bearer token

# Embedding server started by `npm run embed` (optional: without it retrieval is BM25 only).
# EMBED_URL=http://127.0.0.1:8081
# EMBED_MODEL=embed
# EMBED_API_KEY=change-me

# CHAT_RATE_LIMIT=30             # requests per 10 minutes per client (set high when running eval/run.mjs)
# CHAT_TIMEOUT_MS=150000
