# Copy to .env.local and adjust.

# Where the API lives. Server components read from it directly and /api/* in the browser is proxied to it.
# BACKEND_URL=http://127.0.0.1:4000

# Let the browser call the backend directly instead of through the proxy (backend needs CORS_ORIGIN).
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Canned answer stream instead of a model (UI development, no backend needed for the chat itself):
# NEXT_PUBLIC_CHAT_MODE=mock
